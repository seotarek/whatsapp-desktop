    <category>InstantMessaging</category>
  </categories>
  <url type="homepage">https://seotarek.github.io/whatsapp-desktop/</url>
  <url type="bugtracker">https://github.com/seotarek/whatsapp-desktop/issues</url>
  <url type="vcs-browser">https://github.com/seotarek/whatsapp-desktop</url>
